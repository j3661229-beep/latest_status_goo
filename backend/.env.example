# ─────────────────────────────────────────────────────────────
#  STATUS GO BACKEND — Environment Variables
#  Copy this to .env and fill in real values. Placeholders only — never commit secrets.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Reverse-proxy trust for req.ip / rate limiting. Leave unset (false) when the API is
# exposed directly. Behind a load balancer set the number of hops, e.g. TRUST_PROXY=1.
TRUST_PROXY=

# ── PostgreSQL → Supabase ─────────────────────────────────────
# Settings → Database → Connection Pooling (transaction mode) and direct URI
DATABASE_URL="postgresql://postgres.PROJECTID:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECTID:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Redis → Upstash ───────────────────────────────────────────
REDIS_URL="rediss://default:TOKEN@REGION.upstash.io:6380"

# ── JWT Secrets (min 32 chars) ────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_A_64_CHAR_HEX_STRING"
JWT_REFRESH_SECRET="GENERATE_A_DIFFERENT_64_CHAR_HEX_STRING"

# ── Google Sign-In (mobile + creator studio) ──────────────────
GOOGLE_CLIENT_ID="XXXXX.apps.googleusercontent.com"

# ── Phone login ───────────────────────────────────────────────
# 2factor.in API key for SMS OTP (POST /auth/otp/send). Without it OTP send returns 503
# unless ALLOW_TEST_OTP=true.
TWO_FACTOR_API_KEY=""
# Firebase project ID used to verify Firebase phone-auth ID tokens
# (POST /auth/firebase-phone returns 503 when unset).
FIREBASE_PROJECT_ID=""
# Dev/test only: accept OTP 123456 and echo the OTP in the send response.
# Always ignored when NODE_ENV=production.
ALLOW_TEST_OTP=false

# ── Template moderation ───────────────────────────────────────
# true → creator submissions go live immediately; false (default) → PENDING review queue
AUTO_APPROVE_TEMPLATES=false

# ── Razorpay ──────────────────────────────────────────────────
# RAZORPAY_KEY_SECRET is REQUIRED in production (the server refuses to boot otherwise).
RAZORPAY_KEY_ID="rzp_test_XXXXX"
RAZORPAY_KEY_SECRET="XXXXX"
# Webhook URL: https://<api-host>/api/v1/subscribe/webhook (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET="XXXXX"

# ── Media storage ─────────────────────────────────────────────
# Cloudinary (default upload target): cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Alternatively (if CLOUDINARY_URL is not set):
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Google Cloud Storage (optional — used first when GCS_SA_KEY_JSON is set)
GCS_PROJECT_ID="your-gcp-project-id"
GCS_BUCKET_NAME="statusgo-media"
GCS_CDN_BASE_URL="https://storage.googleapis.com/statusgo-media"
# Base64-encoded service-account key JSON
GCS_SA_KEY_JSON=""
# Informational only
GCP_PROJECT_NAME=""
GCP_PROJECT_NUMBER=""

# ── OneSignal (push) ──────────────────────────────────────────
# Unset in development → pushes are simulated (logged once). Unset in production → sends fail.
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_KEY=""

# ── Sentry (optional) ─────────────────────────────────────────
SENTRY_DSN_API=""

# ── Seed / maintenance scripts (not read by the API server) ───
# prisma/seed.ts, prisma/seed-dummy-users.ts, scripts/seed-admin.js
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_CREATOR_PASSWORD=""
# Seeds refuse to run with NODE_ENV=production unless FORCE_SEED=true
FORCE_SEED=false
