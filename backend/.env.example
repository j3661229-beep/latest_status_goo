# ─────────────────────────────────────────────────────────────
#  STATUS GO BACKEND — Environment Variables
#  Copy this to .env — uses cloud services, no Docker needed.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── PostgreSQL → Supabase (free) ──────────────────────────────
# 1. supabase.com → New Project
# 2. Settings → Database → Connection Pooling → Transaction mode URI
# 3. Paste both URLs below (pooled for queries, direct for migrations)
DATABASE_URL="postgresql://postgres.PROJECTID:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECTID:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Redis → Upstash (free) ────────────────────────────────────
# 1. console.upstash.com → Create Database (Mumbai region)
# 2. Copy the rediss:// connection URL
REDIS_URL="rediss://default:TOKEN@REGION.upstash.io:6380"

# ── JWT Secrets ───────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_A_64_CHAR_HEX_STRING"
JWT_REFRESH_SECRET="GENERATE_A_DIFFERENT_64_CHAR_HEX_STRING"

# ── Google OAuth ──────────────────────────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client (Web)
# Authorised JS origins: http://localhost:3000
GOOGLE_CLIENT_ID="XXXXX.apps.googleusercontent.com"

# ── Razorpay ──────────────────────────────────────────────────
# dashboard.razorpay.com → Settings → API Keys (use Test mode keys)
RAZORPAY_KEY_ID="rzp_test_XXXXX"
RAZORPAY_KEY_SECRET="XXXXX"
RAZORPAY_WEBHOOK_SECRET="XXXXX"

# ── Cloudflare R2 (optional — leave blank to skip file uploads)
CF_R2_ACCOUNT_ID=""
CF_R2_ACCESS_KEY=""
CF_R2_SECRET_KEY=""
CF_R2_BUCKET_NAME="status-go-assets"
CF_R2_PUBLIC_URL="https://assets.statusgo.app"

# ── Cloudflare Stream (optional — leave blank to skip videos) ─
CF_STREAM_ACCOUNT_ID=""
CF_STREAM_TOKEN=""

# ── OneSignal (optional — leave blank to skip push notifs) ────
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_KEY=""

# ── Sentry (optional) ─────────────────────────────────────────
SENTRY_DSN_API=""
