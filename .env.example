# ─────────────────────────────────────────────────────────────
#  STATUS GO — ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in your real values.
#  No Docker needed — uses free cloud services for local dev.
# ─────────────────────────────────────────────────────────────

# ── How to get free cloud databases instantly ─────────────────
#
#  PostgreSQL → Supabase (free tier, 500MB)
#    1. Go to https://supabase.com → New Project
#    2. Settings → Database → Connection Pooling section
#    3. Copy "Connection String" (mode: Transaction) → DATABASE_URL
#    4. Copy "Connection String" (mode: Session / direct) → DIRECT_DATABASE_URL
#
#  Redis → Upstash (free tier, 10K req/day)
#    1. Go to https://console.upstash.com → Create Database (region: Mumbai)
#    2. Copy "UPSTASH_REDIS_REST_URL" style → use the rediss:// URL below
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1

# ── PostgreSQL (Supabase) ─────────────────────────────────────
# Paste from Supabase → Settings → Database → URI
DATABASE_URL="postgresql://postgres.PROJECTID:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECTID:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Redis (Upstash) ───────────────────────────────────────────
# Paste from Upstash → Database → "rediss://..." URL
REDIS_URL="rediss://default:TOKEN@REGION.upstash.io:6380"

# ── JWT Secrets ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_A_RANDOM_64_CHAR_HEX_STRING_HERE"
JWT_REFRESH_SECRET="GENERATE_A_DIFFERENT_RANDOM_64_CHAR_HEX_STRING_HERE"

# ── Google OAuth ──────────────────────────────────────────────
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Authorised origins: http://localhost:3000
GOOGLE_CLIENT_ID="XXXXX.apps.googleusercontent.com"

# ── Razorpay ──────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys (use test keys)
RAZORPAY_KEY_ID="rzp_test_XXXXX"
RAZORPAY_KEY_SECRET="XXXXX"
RAZORPAY_WEBHOOK_SECRET="XXXXX"

# ── Cloudflare R2 (optional — file uploads skip gracefully) ───
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
CF_R2_ACCOUNT_ID=""
CF_R2_ACCESS_KEY=""
CF_R2_SECRET_KEY=""
CF_R2_BUCKET_NAME="status-go-assets"
CF_R2_PUBLIC_URL="https://assets.statusgo.app"

# ── Cloudflare Stream (optional — video uploads skip gracefully)
CF_STREAM_ACCOUNT_ID=""
CF_STREAM_TOKEN=""

# ── OneSignal (optional — push notifications skip gracefully) ─
# Get from: https://app.onesignal.com → App → Settings → Keys & IDs
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_KEY=""

# ── Admin Dashboard ───────────────────────────────────────────
NEXTAUTH_SECRET="GENERATE_A_RANDOM_32_CHAR_SECRET_HERE"
NEXTAUTH_URL="http://localhost:3001"
ADMIN_GOOGLE_CLIENT_ID="XXXXX.apps.googleusercontent.com"
ADMIN_GOOGLE_CLIENT_SECRET="XXXXX"

# ── Creator Dashboard ─────────────────────────────────────────
CREATOR_NEXTAUTH_SECRET="GENERATE_A_DIFFERENT_32_CHAR_SECRET"
CREATOR_NEXTAUTH_URL="http://localhost:3002"

# ── Flutter --dart-define ─────────────────────────────────────
# Use these when running: flutter run --dart-define=KEY=VALUE
# FLUTTER_API_BASE_URL=http://10.0.2.2:3000/api/v1   (Android emulator)
# FLUTTER_API_BASE_URL=http://localhost:3000/api/v1   (iOS simulator)
# FLUTTER_ONESIGNAL_APP_ID=XXXXX
# FLUTTER_RAZORPAY_KEY_ID=rzp_test_XXXXX
# FLUTTER_GOOGLE_CLIENT_ID_ANDROID=XXXXX.apps.googleusercontent.com

# ── Sentry (optional — error tracking, skip for dev) ──────────
SENTRY_DSN_API=""
