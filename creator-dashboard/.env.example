# Creator Studio (creator-dashboard) — copy to .env.local and fill in.

# Backend API base URL (including /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Google OAuth web client id for "Continue with Google".
# Leave empty to hide the Google sign-in button.
# In Google Cloud Console add http://localhost:3002 to Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Show the "Fill Demo" credentials button on the login page.
# Only honoured when NODE_ENV=development (i.e. `next dev`); ignored in production builds.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false

# Note: NEXT_PUBLIC_CLOUDINARY_* are NOT needed. The Cloudinary fallback upload gets
# cloudName/apiKey/signature from the backend (POST /creator/upload/sign-cloudinary).
